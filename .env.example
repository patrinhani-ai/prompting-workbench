# Prompting Workbench Environment Variables Example
# Copy this file to .env and update with your actual values

# === Workbench Configuration ===
# Root directory where project folders live (default: ./wrkbnch_projects_space)
# PMPT_WRKBNCH_PROJECTS_DIR="./wrkbnch_projects_space"

# === LLM Provider API Keys ===
# OpenAI API Key (if using OpenAI models)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (if using Claude models)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# === Additional Provider Keys (as needed) ===
# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Google AI (Gemini)
# GOOGLE_API_KEY=your-google-api-key-here

# Cohere
# COHERE_API_KEY=your-cohere-api-key-here
